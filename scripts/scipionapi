#!/usr/bin/env bash
set -euo pipefail

# resolveRepoRootByMarkers
scriptDir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repoRoot="${scriptDir}"
while [[ "${repoRoot}" != "/" ]]; do
  if [[ -f "${repoRoot}/pyproject.toml" ]] && [[ -f "${repoRoot}/alembic.ini" ]]; then
    break
  fi
  repoRoot="$(dirname "${repoRoot}")"
done

if [[ "${repoRoot}" == "/" ]]; then
  echo "ERROR: Could not locate repo root (pyproject.toml + alembic.ini)." >&2
  exit 1
fi

# configDefaults
condaEnvName="${SCIPIONAPI_CONDA_ENV:-scipion4Web}"
pythonVersion="${SCIPIONAPI_PYTHON_VERSION:-3.8}"

# scipionCoreInstallToggle
installScipionCore="${SCIPIONAPI_INSTALL_SCIPION_CORE:-1}"
scipionCorePackages="${SCIPIONAPI_SCIPION_CORE_PACKAGES:-scipion-pyworkflow scipion-em scipion-app}"

# keepExplicitScipionHome
scipionHomeValue="${SCIPION_HOME:-}"

# ensureConda
if ! command -v conda >/dev/null 2>&1; then
  echo "ERROR: conda is required but was not found in PATH." >&2
  exit 1
fi

printWrapperHelp() {
  # printWrapperHelp
  cat <<EOF
ScipionAPI wrapper (conda-managed)

This script runs the scipionapi CLI inside a conda env.

Conda env:
  ${condaEnvName}

Typical usage:
  ./scripts/scipionapi bootstrap
  ./scripts/scipionapi provision --user ... --email ... --pass ... [--web-dist <dir|zip>]
  ./scripts/scipionapi install --user ... --email ... --pass ...
  ./scripts/scipionapi start|stop|restart|status|logs

Notes:
  - The conda env is only created/bootstrapped by: bootstrap, provision
  - To override env name: export SCIPIONAPI_CONDA_ENV=<name>
  - To force an isolated home: export SCIPION_HOME=<path>
EOF
}

envExistsNow() {
  # envExistsNow
  if conda env list | awk '{print $1}' | grep -qx "${condaEnvName}"; then
    echo "1"
  else
    echo "0"
  fi
}

scipionapiInstalled() {
  # scipionapiInstalled
  if [[ -n "${scipionHomeValue}" ]]; then
    env SCIPION_HOME="${scipionHomeValue}" \
      conda run -n "${condaEnvName}" scipionapi --help >/dev/null 2>&1
  else
    conda run -n "${condaEnvName}" scipionapi --help >/dev/null 2>&1
  fi
}

ensureScipionCoreInstalled() {
  # ensureScipionCoreInstalled
  if [[ "${installScipionCore}" != "1" ]]; then
    return 0
  fi

  # checkPyworkflowImport
  if conda run -n "${condaEnvName}" python -c "import pyworkflow" >/dev/null 2>&1; then
    return 0
  fi

  echo "Installing Scipion core packages (pyworkflow/em/app)"
  conda run -n "${condaEnvName}" python -m pip install ${scipionCorePackages}

  # verifyPyworkflowImport
  conda run -n "${condaEnvName}" python -c "import pyworkflow" >/dev/null 2>&1 || {
    echo "ERROR: pyworkflow import still failing after installing Scipion core packages." >&2
    exit 1
  }
}

bootstrapEnv() {
  # bootstrapEnv
  cd "${repoRoot}"

  local exists
  exists="$(envExistsNow)"

  if [[ "${exists}" == "0" ]]; then
    echo "Creating conda env: ${condaEnvName} (python=${pythonVersion})"
    conda create -y -n "${condaEnvName}" "python=${pythonVersion}"
  fi

  echo "Upgrading pip"
  conda run -n "${condaEnvName}" python -m pip install --upgrade pip

  if [[ -f "${repoRoot}/requirements.txt" ]]; then
    echo "Installing requirements.txt"
    conda run -n "${condaEnvName}" python -m pip install -r "${repoRoot}/requirements.txt"
  fi

  # optionalScipionCoreInstall
  ensureScipionCoreInstalled

  echo "Installing package (editable)"
  conda run -n "${condaEnvName}" python -m pip install -e "${repoRoot}"

  echo "Bootstrap completed."
}

requireEnvOrExplain() {
  # requireEnvOrExplain
  if [[ "$(envExistsNow)" == "0" ]]; then
    echo "ERROR: conda env '${condaEnvName}' does not exist." >&2
    echo "Run: ./scripts/scipionapi bootstrap" >&2
    echo "Or:  ./scripts/scipionapi provision --user ... --email ... --pass ..." >&2
    exit 1
  fi

  if ! scipionapiInstalled; then
    echo "ERROR: scipionapi is not installed in conda env '${condaEnvName}'." >&2
    echo "Run: ./scripts/scipionapi bootstrap" >&2
    exit 1
  fi
}

runInCondaCli() {
  # runInCondaCli
  if [[ -n "${scipionHomeValue}" ]]; then
    exec env SCIPION_HOME="${scipionHomeValue}" \
      conda run -n "${condaEnvName}" scipionapi "$@"
  else
    exec conda run -n "${condaEnvName}" scipionapi "$@"
  fi
}

# routeCommand
cmd="${1:-}"

# wrapperHelpFastPath (do not create env for help)
if [[ -z "${cmd}" ]] || [[ "${cmd}" == "--help" ]] || [[ "${cmd}" == "-h" ]] || [[ "${cmd}" == "help" ]]; then
  if [[ "$(envExistsNow)" == "1" ]] && scipionapiInstalled; then
    if [[ -n "${scipionHomeValue}" ]]; then
      exec env SCIPION_HOME="${scipionHomeValue}" \
        conda run -n "${condaEnvName}" scipionapi --help
    fi
    exec conda run -n "${condaEnvName}" scipionapi --help
  fi
  printWrapperHelp
  exit 0
fi

if [[ "${cmd}" == "bootstrap" ]]; then
  shift || true
  bootstrapEnv
  exit 0
fi

if [[ "${cmd}" == "provision" ]]; then
  shift || true
  bootstrapEnv
  cd "${repoRoot}"
  runInCondaCli provision "$@"
fi

# for any other command: require env + cli, do not auto-create
requireEnvOrExplain

cd "${repoRoot}"
runInCondaCli "$@"